# PartyGames — regras do Apache
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Pastas internas: configuração, código, migrações, registros e templates
    RewriteRule ^(config|app|database|storage|views)(/|$) - [F,L]
    # Código, migrações, telas e manifesto dos jogos (só games/*/assets/ é público)
    RewriteRule ^games/[^/]+/(src|migrations|views|content|cases|game\.php)(/|$) - [F,L]
    # Arquivos ocultos (.htaccess, .git, .env...)
    RewriteRule (^|/)\. - [F,L]
</IfModule>

<FilesMatch "\.(md|log|sql|ini|bak|dist)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|svg)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>
